# Base de datos. Nunca confirmar una URL real ni credenciales.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Barrera temporal de contención (Fase 0).
# En Vercel/producción la barrera siempre está activa.
APP_ACCESS_USER="hospital-dia"
APP_ACCESS_PASSWORD="REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS"

# Solo para probar la barrera durante desarrollo local.
APP_ACCESS_GATE="off"
