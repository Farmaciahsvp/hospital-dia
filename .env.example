# Base de datos. Nunca confirmar una URL real ni credenciales.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Barrera temporal de contención (Fase 0).
# En Vercel/producción la barrera siempre está activa.
APP_ACCESS_USER="hospital-dia"
APP_ACCESS_PASSWORD="REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS"

# Modo de acceso durante la transición:
# basic = solo barrera compartida; hybrid = barrera + usuario individual;
# individual = solo Supabase Auth.
APP_AUTH_MODE="basic"

# Solo para probar la barrera durante desarrollo local.
APP_ACCESS_GATE="off"

# Supabase Auth. La clave publishable/anon es pública por diseño; nunca usar
# service_role en variables NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="REEMPLAZAR_POR_PUBLISHABLE_KEY"
